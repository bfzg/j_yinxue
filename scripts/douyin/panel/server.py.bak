.card h3 { font-size: 12px; color: var(--muted); margin-bottom: 6px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; }
.card .value { font-size: 28px; font-weight: 700; line-height: 1.2; display: flex; align-items: baseline; gap: 6px; }
.card .value-sub { font-size: 13px; font-weight: 400; color: var(--muted); }
