</div>

<script>
async function api(url, opts = {}) {
  try {
    const res = await fetch(url, opts);
    return await res.json();
  } catch(e) {
    showOutput('请求失败: ' + e.message);
    return null;
  }
}

function showOutput(text) {
  const box = document.getElementById('outputBox');
  const msg = typeof text === 'string' ? text : JSON.stringify(text, null, 2);
  box.textContent = msg;
  box.style.display = 'block';
  box.scrollTop = box.scrollHeight;
}

function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function renderMarkdown(text) {
  if (!text) return '';
  let html = escapeHtml(text);
  // Headers
  html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
  html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
  // Bold
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  // Italic
  html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
  // Inline code
  html = html.replace(/`(.+?)`/g, '<code>$1</code>');
  // Blockquote
  html = html.replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>');
  // Unordered list
  html = html.replace(/^- (.+)$/gm, '<li>$1</li>').replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>');
  // Ordered list
  html = html.replace(/^\d+\. (.+)$/gm, '<li>$1</li>');
  // Double line break = new paragraph
  html = html.replace(/\n\n/g, '</p><p>');
  // Single line break = br
  html = html.replace(/\n/g, '<br>');
  return '<p>' + html + '</p>';
}

async function refreshStatus() {
  const data = await api('/api/status');
  if (!data) return;
  document.getElementById('statVideos').textContent = data.videos.count;
  document.getElementById('statAudio').textContent = data.audio.count;
  document.getElementById('statSubtitles').textContent = data.subtitles.count;
  document.getElementById('statArticlesPub').textContent = data.articles.published;
  document.getElementById('statArticlesTotal').textContent = data.articles.count;
  document.getElementById('lastUpdate').textContent = '更新: ' + new Date().toLocaleTimeString('zh-CN');

  // --- Local files tab ---
  if (data.local && data.local.items) {
    const localHtml = Object.entries(data.local.items).map(([key, item]) => {
      const audioExists = item.audio ? '<span class="status-dot status-ok"></span>' : '<span class="status-dot status-missing"></span>';
      const srtExists = item.srt ? '<span class="status-dot status-ok"></span>' : '<span class="status-dot status-missing"></span>';
      const articleExists = item.article ? '<span class="status-dot status-ok"></span>' : '<span class="status-dot status-missing"></span>';
      const pubExists = item.published ? '<span class="status-dot status-ok"></span>已发布' : '<span class="status-dot status-missing"></span>未发布';
      let title = item.title || item.audio_name || key;
      return `<tr>
        <td>${key}</td>
        <td>${audioExists} ${escapeHtml(item.audio_name || '-')}</td>
        <td>${srtExists} ${item.srt ? '有' : '无'}</td>
        <td>${articleExists} ${item.article ? '有' : '无'}</td>
        <td>${pubExists}</td>
        <td>
          ${item.audio ? `<button class="btn btn-sm" onclick="previewAudio('${encodeURIComponent(item.audio)}')">🎵播放</button>` : ''}
          ${item.article_path ? `<button class="btn btn-sm" onclick="previewArticle('${encodeURIComponent(item.article_path)}')">📖预览</button>` : ''}
        </td>
      </tr>`;
    }).join('');
    document.getElementById('localBody').innerHTML = localHtml;
  }

  // --- Published articles tab ---
  const articlesHtml = (data.articles_json.items || []).slice().reverse().map(a => {
    const hasAudio = a.audioUrl ? '<span class="status-dot status-ok"></span>有' : '<span class="status-dot status-missing"></span>无';
    const hasArticle = a.articleUrl ? '<span class="status-dot status-ok"></span>有' : '<span class="status-dot status-missing"></span>无';
    return `<tr>
      <td>${a.id || '-'}</td>
      <td>${escapeHtml(a.title || '-')}</td>
      <td>${a.category || '-'}</td>
      <td>${a.publishedAt || '-'}</td>
      <td>${hasAudio}</td>
      <td>${hasArticle}</td>
      <td><button class="btn btn-sm" onclick="viewArticle('${a.id}')">👁️ 查看</button></td>
    </tr>`;
  }).join('');
  document.getElementById('articlesBody').innerHTML = articlesHtml;

  // --- Playlist tab ---
  const playlistHtml = (data.playlist.items || []).slice().reverse().map(a => {
    return `<tr>
      <td>${a.id || '-'}</td>
      <td>${escapeHtml(a.title || '-')}</td>
      <td>${a.duration || 0}s</td>
      <td>${a.publishedAt || '-'}</td>
      <td>${a.enabled ? '<span class="status-dot status-ok"></span>启用' : '<span class="status-dot status-missing"></span>禁用'}</td>
    </tr>`;
  }).join('');
  document.getElementById('playlistBody').innerHTML = playlistHtml;
}

async function runPipeline(step) {
  showOutput('⏳ 正在执行: ' + step + ' ...');
  const result = await api('/api/pipeline/run?step=' + step, {method: 'POST'});
  if (result) {
    let out = result.stdout || '';
    if (result.stderr) out += '\n\n错误:\n' + result.stderr;
    showOutput(out);
  }
  setTimeout(refreshStatus, 1500);
}

async function generateArticle() {
  showOutput('⏳ 正在批量生成文章...');
  const result = await api('/api/pipeline/generate-article', {method: 'POST'});
  if (result) {
    let out = result.stdout || '';
    if (result.stderr) out += '\n\n错误:\n' + result.stderr;
    showOutput(out);
  }
  setTimeout(refreshStatus, 1500);
}

async function publishLatest() {
  showOutput('⏳ 正在发布最新文章...');
  const result = await api('/api/pipeline/publish', {method: 'POST'});
  if (result) {
    let out = result.stdout || '';
    if (result.stderr) out += '\n\n错误:\n' + result.stderr;
    showOutput(out);
  }
  setTimeout(refreshStatus, 1500);
}

function previewAudio(audioPath) {
  const path = decodeURIComponent(audioPath);
  const modalHtml = `<div class="modal-overlay show" id="audioModal" onclick="if(event.target===this)document.getElementById('audioModal').remove()">
    <div class="modal" style="max-width:500px">
      <span class="modal-close" onclick="document.getElementById('audioModal').remove()">✕</span>
      <h3>🎵 音频播放</h3>
      <p style="color:var(--muted);font-size:13px;margin-bottom:12px">${escapeHtml(path.split('/').pop())}</p>
      <div class="audio-player">
        <audio controls autoplay style="width:100%">
          <source src="/api/audio-file?path=${encodeURIComponent(path)}" type="audio/mpeg">
        </audio>
      </div>
    </div>
  </div>`;
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  document.getElementById('audioModal').onclick = function(e) { if(e.target === this) this.remove(); };
}

async function previewArticle(articlePath) {
  const path = decodeURIComponent(articlePath);
  showOutput('⏳ 加载文章...');
  const data = await api('/api/article-content?path=' + encodeURIComponent(path));
  if (!data) return;
  const a = data.article;
  const modalHtml = `<div class="modal-overlay show" id="articleModal" onclick="if(event.target===this)document.getElementById('articleModal').remove()">
    <div class="modal">
      <span class="modal-close" onclick="document.getElementById('articleModal').remove()">✕</span>
      <h3>${escapeHtml(a.title || '无标题')}</h3>
      <div class="meta">
        <span>📂 ${escapeHtml(a.category || '其他')}</span>
        ${a.audio_path ? '<span>🎵 有音频</span>' : ''}
      </div>
      ${a.summary ? '<p style="color:var(--muted);font-size:14px;margin-bottom:16px;border-left:3px solid var(--accent);padding-left:12px">' + escapeHtml(a.summary) + '</p>' : ''}
      ${a.audio_path ? `<div class="audio-player"><audio controls style="width:100%"><source src="/api/audio-file?path=${encodeURIComponent(a.audio_path)}" type="audio/mpeg"></audio></div>` : ''}
      <div class="article-body">${renderMarkdown(a.content || '')}</div>
    </div>
  </div>`;
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  document.getElementById('articleModal').onclick = function(e) { if(e.target === this) this.remove(); };
}

async function viewArticle(id) {
  const data = await api('/api/articles/' + id);
  if (!data) return;
  const modalHtml = `<div class="modal-overlay show" id="articleModal" onclick="if(event.target===this)document.getElementById('articleModal').remove()">
    <div class="modal">
      <span class="modal-close" onclick="document.getElementById('articleModal').remove()">✕</span>
      <h3>${escapeHtml(data.title || '无标题')}</h3>
      <div class="meta">
        <span>📂 ${escapeHtml(data.category || '-')}</span>
        <span>📅 ${data.publishedAt || '-'}</span>
        <span>🆔 ${data.id}</span>
      </div>
      <p style="color:var(--muted);font-size:14px;margin-bottom:16px;border-left:3px solid var(--accent);padding-left:12px">${escapeHtml(data.summary || '')}</p>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        ${data.audioUrl ? `<div class="audio-player"><audio controls style="width:100%"><source src="${data.audioUrl}" type="audio/mpeg"></audio></div>` : ''}
        ${data.articleUrl ? `<a class="btn btn-primary" href="${data.articleUrl}" target="_blank">📖 查看文章</a>` : ''}
      </div>
    </div>
  </div>`;
  document.body.insertAdjacentHTML('beforeend', modalHtml);
  document.getElementById('articleModal').onclick = function(e) { if(e.target === this) this.remove(); };
}

function switchTab(tab, btn) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tabLocal').style.display = tab === 'local' ? '' : 'none';
  document.getElementById('tabArticles').style.display = tab === 'articles' ? '' : 'none';
  document.getElementById('tabPlaylist').style.display = tab === 'playlist' ? '' : 'none';
}

// Initial load
refreshStatus();
</script>
</body>
</html>"""
    uvicorn.run(app, host="127.0.0.1", port=8765, log_level="info")


if __name__ == "__main__":
    main()
