"""
九哥隐学 - Pipeline 管理面板后端

一个轻量级 FastAPI 服务，提供:
  1. Pipeline 控制面板 (HTML)
  2. REST API: 查看状态、触发任务

启动: uvicorn panel.server:app --reload --port 8765
"""
import json
import sys
import subprocess
from pathlib import Path
from datetime import datetime
from typing import Optional

import uvicorn
from fastapi import FastAPI, Query, HTTPException
from fastapi.responses import HTMLResponse, JSONResponse, FileResponse
from fastapi.staticfiles import StaticFiles

# 确保能找到 douyin 模块
sys.path.insert(0, str(Path(__file__).parent.parent))
import config

app = FastAPI(title="九哥隐学 Pipeline 管理面板")

# 项目根路径
PROJECT_ROOT = Path(__file__).parent.parent.parent.parent
SCRIPTS_DIR = Path(__file__).parent.parent
VENV_PYTHON = SCRIPTS_DIR / ".venv" / "bin" / "python"


# ========== 数据查询 ==========

def load_json(path: Path) -> dict:
    if path.exists():
        try:
            return json.loads(path.read_text(encoding="utf-8"))
        except:
            pass
    return {}


def get_pipeline_status() -> dict:
    """获取完整 pipeline 状态"""
    metadata = load_json(config.METADATA_FILE)
    articles_data = load_json(PROJECT_ROOT / "src" / "static" / "data" / "articles.json")
    playlist_data = load_json(PROJECT_ROOT / "src" / "static" / "data" / "playlist.json")

    # 扫描本地文件
    audio_files = sorted(config.AUDIO_DIR.glob("*.mp3"))
    srt_files = sorted(config.SUBTITLES_DIR.glob("*.srt"))
    article_files = sorted(config.ARTICLES_DIR.glob("*.article.json"))
    txt_files = sorted(config.ARTICLES_DIR.glob("*.txt"))

    # 文章条目（来自 articles.json）
    articles = articles_data.get("items", [])
    playlist_items = playlist_data.get("items", [])

    # 分析状态
    status = {
        "videos": {
            "count": len(list(config.VIDEOS_DIR.rglob("*.mp4"))),
        },
        "audio": {
            "count": len(audio_files),
            "files": [f.name for f in audio_files[-10:]],
        },
        "subtitles": {
            "count": len(srt_files),
            "files": [f.name for f in srt_files[-10:]],
        },
        "articles": {
            "count": len(article_files),
            "published": sum(1 for a in articles if a.get("articleUrl")),
            "draft": len(article_files) - sum(1 for a in articles if a.get("articleUrl")),
            "files": [f.name for f in article_files[-10:]],
        },
        "playlist": {
            "count": len(playlist_items),
            "items": playlist_items[-10:],
        },
        "articles_json": {
            "count": len(articles),
            "items": articles[-20:],
        },
        "metadata": metadata,
        "pipeline_enabled": config.ARTICLE_ENABLED,
        "local": {
            "items": _get_local_files_status(),
        },
        "last_update": datetime.now().isoformat(),
    }

    return status


def _get_local_files_status() -> dict:
    """扫描本地文件，按音频文件建立索引"""
    import re as _re
    items = {}

    # 扫描所有 MP3
    for mp3 in sorted(config.AUDIO_DIR.glob("*.mp3")):
        base = mp3.stem
        # 去掉 _video 后缀
        clean_base = _re.sub(r'_video$', '', base)
        key = clean_base[:40]  # 截断作为 key

        item = {
            "audio": str(mp3),
            "audio_name": mp3.name,
            "srt": None,
            "article": None,
            "article_path": None,
            "published": False,
            "title": clean_base,
        }

        # 查找对应 SRT
        srt_path = config.SUBTITLES_DIR / (base + ".srt")
        if not srt_path.exists():
            srt_path = config.SUBTITLES_DIR / (mp3.stem + ".srt")
        if srt_path.exists():
            item["srt"] = str(srt_path)

        # 查找对应文章
        article_path = config.ARTICLES_DIR / (base + ".article.json")
        if not article_path.exists():
            article_path = config.ARTICLES_DIR / (mp3.stem + ".article.json")
        if article_path.exists():
            item["article"] = str(article_path)
            item["article_path"] = str(article_path)
            try:
                article_data = json.loads(article_path.read_text(encoding="utf-8"))
                item["title"] = article_data.get("title", clean_base)
            except:
                pass

        # 检查是否已发布（通过 articles.json 检查）
        try:
            articles_data = load_json(Path(__file__).parent.parent.parent / "src" / "static" / "data" / "articles.json")
            for entry in articles_data.get("items", []):
                if entry.get("audioUrl") and mp3.name in entry.get("audioUrl", ""):
                    item["published"] = True
                    break
        except:
            pass

        items[clean_base[:30]] = item

    return items



# ========== API 路由 ==========

@app.get("/api/status")
def api_status():
    return get_pipeline_status()


@app.post("/api/pipeline/run")
def run_pipeline(step: str = Query("all", description="执行步骤: scrape/extract/transcribe/article/all")):
    """触发 pipeline 执行"""
    env = {}
    cmd = [str(VENV_PYTHON), str(SCRIPTS_DIR / "main.py"), "--step", step]

    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=600,
            env=env,
        )
        return {
            "success": result.returncode == 0,
            "step": step,
            "stdout": result.stdout[-2000:],
            "stderr": result.stderr[-2000:] if result.stderr else "",
        }
    except subprocess.TimeoutExpired:
        return {"success": False, "step": step, "error": "执行超时（>10分钟）"}
    except Exception as e:
        return {"success": False, "step": step, "error": str(e)}



@app.post("/api/pipeline/generate-article")
def generate_article(srt: str = Query(None, description="指定 SRT 文件名（可选）")):
    """生成文章"""
    if srt:
        srt_path = config.SUBTITLES_DIR / srt
        if not srt_path.exists():
            raise HTTPException(status_code=404, detail=f"SRT 文件不存在: {srt}")
        cmd = [str(VENV_PYTHON), str(SCRIPTS_DIR / "article_writer.py"), str(srt_path)]
    else:
        cmd = [str(VENV_PYTHON), str(SCRIPTS_DIR / "article_writer.py"), "--dir", str(config.SUBTITLES_DIR)]

    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
        return {
            "success": result.returncode == 0,
            "stdout": result.stdout[-2000:],
            "stderr": result.stderr[-2000:],
        }
    except Exception as e:
        return {"success": False, "error": str(e)}


@app.post("/api/pipeline/publish")
def publish_article(article_name: str = Query(None, description="article.json 文件名（可选）")):
    """发布文章到 COS + 更新 JSON"""
    if article_name:
        article_path = config.ARTICLES_DIR / article_name
        if not article_path.exists():
            raise HTTPException(status_code=404, detail=f"文章文件不存在: {article_name}")
        cmd = [str(VENV_PYTHON), str(SCRIPTS_DIR / "uploader.py"), str(article_path)]
    else:
        # 找最新的未发布文章
        article_files = sorted(config.ARTICLES_DIR.glob("*.article.json"))
        if not article_files:
            raise HTTPException(status_code=404, detail="没有找到未发布的文章")
        cmd = [str(VENV_PYTHON), str(SCRIPTS_DIR / "uploader.py"), str(article_files[-1])]

    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        return {
            "success": result.returncode == 0,
            "stdout": result.stdout[-2000:],
            "stderr": result.stderr[-2000:],
        }
    except Exception as e:
        return {"success": False, "error": str(e)}


@app.get("/api/articles/{article_id}")
def get_article(article_id: str):
    """获取单篇文章详情"""
    articles_data = load_json(PROJECT_ROOT / "src" / "static" / "data" / "articles.json")
    for item in articles_data.get("items", []):
        if item.get("id") == article_id:
            return item
    raise HTTPException(status_code=404, detail="文章不存在")


# ========== 页面路
@app.get("/api/audio-file")
def serve_audio(path: str = Query(..., description="MP3 文件路径")):
    """提供本地音频文件播放"""
    audio_path = Path(path)
    if not audio_path.exists() or not audio_path.suffix.lower() in {'.mp3', '.wav', '.m4a'}:
        from fastapi.responses import PlainTextResponse
        return PlainTextResponse("文件不存在", status_code=404)
    return FileResponse(str(audio_path), media_type="audio/mpeg", filename=audio_path.name)


@app.get("/api/article-content")
def get_article_content(path: str = Query(..., description=".article.json 文件路径")):
    """获取本地文章内容"""
    article_path = Path(path)
    if not article_path.exists():
        return {"error": "文件不存在"}
    try:
        data = json.loads(article_path.read_text(encoding="utf-8"))
        # 查找对应的音频文件
        audio_name = article_path.stem.replace(".article", "") + ".mp3"
        audio_path = config.AUDIO_DIR / audio_name
        if audio_path.exists():
            data["audio_path"] = str(audio_path)

        # 查找对应 SRT
        srt_name = article_path.stem.replace(".article", "") + ".srt"
        srt_path = config.SUBTITLES_DIR / srt_name
        if srt_path.exists():
            data["srt_path"] = str(srt_path)

        return {"article": data, "path": str(article_path)}
    except Exception as e:
        return {"error": str(e)}

由 ==========

@app.get("/", response_class=HTMLResponse)
def index():
    """管理面板主页"""
    return HTMLResponse(INDEX_HTML)


# 内嵌 HTML 模板
